{
  "name": "@saas/identity-platform-shared",
  "version": "0.2.0",
  "description": "SaaS Identity Platform — TypeSpec SSOT. Pure contract source-of-truth: TypeSpec → OpenAPI 3.1 only. Language-specific clients (TS / Java / C# / Kotlin / Swift) are generated by each consuming project.",
  "type": "module",
  "exports": {
    ".": "./main.tsp",
    "./openapi": "./generated/openapi/openapi.yaml"
  },
  "files": [
    "main.tsp",
    "tsp",
    "scripts",
    "generated",
    "tsconfig.json",
    "tspconfig.yaml"
  ],
  "scripts": {
    "build": "npm run emit:openapi",
    "emit:openapi": "tsx scripts/codegen/emit-openapi.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate-db.mjs",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:introspect": "drizzle-kit pull --config drizzle.config.ts",
    "lint": "tsp compile . --no-emit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/node": "^22.10.0",
    "@typespec/compiler": "^1.0.0",
    "@typespec/http": "^1.15.0",
    "@typespec/openapi3": "^1.0.0",
    "drizzle-kit": "^0.28.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typespec/openapi": "^1.15.0",
    "@typespec/rest": "^0.85.0"
  }
}