{
  "schema": 1,
  "family": "saas-identity-platform",
  "members": {
    "react": [
      "frontend"
    ],
    "vue": [
      "frontend"
    ],
    "nextjs": [
      "frontend",
      "backend"
    ],
    "springboot": [
      "backend"
    ],
    "aspnetcore": [
      "backend"
    ]
  },
  "synced_keys": {
    "PG_HOST": {
      "scope": [
        "shared",
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "PG_PORT": {
      "scope": [
        "shared",
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "PG_USER": {
      "scope": [
        "shared",
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "PG_PASSWORD": {
      "secret": true,
      "scope": [
        "shared",
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "PG_DATABASE": {
      "scope": [
        "shared",
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "JWT_SIGNING_KEY": {
      "secret": true,
      "scope": [
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "JWT_ISSUER": {
      "scope": [
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "JWT_AUDIENCE": {
      "scope": [
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "JWT_TTL_SECONDS": {
      "scope": [
        "aspnetcore",
        "springboot",
        "nextjs"
      ]
    },
    "SAAS_CORS_ALLOWED_ORIGINS": {
      "scope": [
        "aspnetcore",
        "springboot"
      ]
    }
  }
}
