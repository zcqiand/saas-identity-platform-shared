{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./generated/ts/dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@saas/shared": ["./generated/ts/index.ts"],
      "@saas/shared/api-client": ["./generated/ts/api-client/endpoints.ts"],
      "@saas/shared/msw": ["./generated/ts/msw/handlers.ts"],
      "@saas/shared/zod-schemas": ["./generated/ts/zod-schemas.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "generated",
    "dist",
    "build"
  ]
}